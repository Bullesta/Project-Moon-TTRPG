<section class="damage-taken{{#if isReverted}} reverted{{/if}}">
  <span class="statements">{{{statements}}}</span>
  {{#if hasBreakdown}}
    <span class="damage-breakdown"><i class="fas fa-circle-info" inert></i></span>
  {{/if}}
  {{#if changes.length}}
    <ul class="damage-taken__pools">
      {{#each changes as |c|}}
        <li class="damage-taken__pool{{#if c.heal}} is-heal{{else}} is-damage{{/if}}">
          <span class="amount">{{#if c.heal}}+{{else}}−{{/if}}{{c.amount}}</span>
          <span class="pool">{{c.label}}</span>
        </li>
      {{/each}}
    </ul>
  {{/if}}
  {{#if canUndoDamage}}
    <button type="button" class="revert-damage" data-action="revert-damage" title="{{localize "PMTTRPG.DamageTaken.RevertTooltip"}}">
      <i class="fas fa-rotate-left"></i>
    </button>
  {{/if}}
</section>
