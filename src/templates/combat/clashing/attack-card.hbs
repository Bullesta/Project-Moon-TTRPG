<div class="clash-card clash-attack-card" data-phase="{{state.phase}}">

  {{!-- Header --}}
  <div class="clash-card__header">
    <img class="clash-card__avatar" src="{{state.attackerImg}}" alt="{{state.attackerName}}">
    <div class="clash-card__header-text">
      <span class="clash-card__actor-name">{{state.attackerName}}</span>
      <span class="clash-card__item-name">{{i18n.using}} {{state.attackerItemName}}</span>
      <span class="clash-card__target-line">
        {{#if state.targetName}}
          {{i18n.targeting}} {{state.targetName}}
        {{else}}
          {{i18n.targeting}}
        {{/if}}
      </span>
    </div>
    {{#if state.targetImg}}
      <img class="clash-card__avatar clash-card__avatar--target" src="{{state.targetImg}}" alt="{{state.targetName}}">
    {{/if}}
  </div>

  {{#if (eq state.phase "pending")}}
    {{#unless state.attackRollTotal}}
      <div class="clash-card__challenge-notice">
        {{i18n.challengeNotice}}
      </div>
    {{else}}
      <div class="clash-card__roll-wrapper">
        <div class="clash-card__roll" data-clash-breakdown="attack">
          {{{rollHtml}}}
        </div>
      </div>
    {{/unless}}
  {{else if rollHtml}}
    <div class="clash-card__roll-wrapper">
      <div class="clash-card__roll" data-clash-breakdown="attack">
        {{{rollHtml}}}
      </div>
    </div>
  {{/if}}

  {{#if (eq state.phase "pending")}}
    <div class="clash-card__actions">
      {{!-- Primary target gets a highlighted blue Retaliate button --}}
      {{#if state.targetActorId}}
        <button
          class="clash-btn clash-btn--retaliate clash-btn--primary"
          data-action="clash-retaliate"
          data-message-id="{{state.attackMessageId}}"
          title="{{i18n.retaliateHint}}"
        >
          <i class="fa-solid fa-shield-halved"></i>
          {{i18n.retaliate}}
        </button>
      {{/if}}

      <button
        class="clash-btn clash-btn--intercept"
        data-action="clash-intercept"
        data-message-id="{{state.attackMessageId}}"
        title="{{i18n.interceptHint}}"
      >
        <i class="fa-solid fa-person-running"></i>
        {{i18n.intercept}}
      </button>
    </div>

  {{else if (eq state.phase "rolling")}}
    <div class="clash-card__status clash-card__status--rolling">
      <i class="fa-solid fa-hourglass-half fa-spin"></i>
      {{localize "PMTTRPG.Clash.WaitingForRoll"}}
      {{#if state.retaliatorName}}
        ({{state.retaliatorName}})
      {{/if}}
    </div>

  {{else}}
    <div class="clash-card__status clash-card__status--resolved">
      <i class="fa-solid fa-check-circle"></i>
      {{i18n.resolved}}
      {{#if state.retaliatorName}}
        ({{state.retaliatorName}})
      {{/if}}
    </div>
  {{/if}}

</div>
