<div class="clash-card clash-result-card
  {{#if attackerWon}}clash-result-card--attack-win{{/if}}
  {{#if defenderWon}}clash-result-card--defense-win{{/if}}"
  data-phase="{{state.phase}}">

  {{!-- VS Header --}}
  <div class="clash-result-card__vs">
    <div class="clash-result-card__side clash-result-card__side--attacker{{#if (eq applyTarget.side "attacker")}} clash-result-card__side--apply-target{{#if (eq applyTarget.kind "heal")}} clash-result-card__side--apply-heal{{/if}}{{/if}}">
      <img class="clash-card__avatar" src="{{state.attackerImg}}" alt="{{state.attackerName}}">
      <span class="clash-result-card__name">{{state.attackerName}}</span>
      <span class="clash-result-card__item">{{state.attackerItemName}}</span>
      <span class="clash-result-card__roll-total clash-roll-total--hoverable
        {{#if attackerWon}}clash-result-card__roll-total--winner{{/if}}"
        data-clash-breakdown="attack"
        tabindex="0"
        aria-label="{{localize "PMTTRPG.Clash.Breakdown.Title"}}">
        {{state.attackRollTotal}}
      </span>
      {{#if attackerWon}}
      <span class="clash-result-card__role clash-result-card__role--winner">{{i18n.winner}}</span>
      {{else if defenderWon}}
      <span class="clash-result-card__role clash-result-card__role--loser">{{i18n.loser}}</span>
      {{/if}}
    </div>

    <div class="clash-result-card__divider">
      <span class="clash-result-card__vs-label">VS</span>
    </div>

    <div class="clash-result-card__side clash-result-card__side--defender{{#if (eq applyTarget.side "defender")}} clash-result-card__side--apply-target{{#if (eq applyTarget.kind "heal")}} clash-result-card__side--apply-heal{{/if}}{{/if}}">
      <img class="clash-card__avatar" src="{{state.retaliatorImg}}" alt="{{state.retaliatorName}}">
      <span class="clash-result-card__name">{{state.retaliatorName}}</span>
      <span class="clash-result-card__item">{{state.retaliatorItemName}}</span>
      <span class="clash-result-card__roll-total clash-roll-total--hoverable
        {{#if defenderWon}}clash-result-card__roll-total--winner{{/if}}"
        data-clash-breakdown="defense"
        tabindex="0"
        aria-label="{{localize "PMTTRPG.Clash.Breakdown.Title"}}">
        {{state.defenseRollTotal}}
      </span>
      {{#if defenderWon}}
      <span class="clash-result-card__role clash-result-card__role--winner">{{i18n.winner}}</span>
      {{else if attackerWon}}
      <span class="clash-result-card__role clash-result-card__role--loser">{{i18n.loser}}</span>
      {{/if}}
    </div>
  </div>

  <div class="clash-result-card__defense-roll">
    {{{defenseRollHtml}}}
  </div>

  {{!-- Result banner --}}
  <div class="clash-result-card__result-banner">
    {{#if evadeWin}}
      <i class="fa-solid fa-wind"></i>
      {{i18n.evadeWin}}
    {{else if counterWin}}
      <i class="fa-solid fa-reply"></i>
      {{i18n.counterWin}}
    {{else if defenderWon}}
      <i class="fa-solid fa-shield"></i>
      {{i18n.defenseWin}}
    {{else}}
      <i class="fa-solid fa-sword"></i>
      {{i18n.attackWin}}
    {{/if}}
  </div>

  {{!-- Damage summary (attack win only) --}}
  {{#if attackerWon}}
    <div class="clash-result-card__damage-summary">
      <div class="clash-damage-line clash-damage-line--hp">
        <i class="fa-solid fa-heart"></i>
        {{state.hpDamage}}
        {{i18n.hpDamage}}
      </div>
      <div class="clash-damage-line clash-damage-line--st">
        <i class="fa-solid fa-shield"></i>
        {{state.stDamage}}
        {{i18n.stDamage}}
      </div>
      <div class="clash-damage-type-badge clash-damage-type--{{state.damageType}}">
        {{i18n.damageType}}
      </div>
    </div>
  {{/if}}

  {{#if counterHit}}
    <div class="clash-result-card__damage-summary">
      <div class="clash-damage-line clash-damage-line--hp">
        <i class="fa-solid fa-heart"></i>
        {{state.hpDamage}}
        {{i18n.hpDamage}}
      </div>
      <div class="clash-damage-line clash-damage-line--st">
        <i class="fa-solid fa-shield"></i>
        {{state.stDamage}}
        {{i18n.stDamage}}
      </div>
      <div class="clash-damage-type-badge clash-damage-type--{{state.damageType}}">
        {{i18n.damageType}}
      </div>
    </div>
  {{/if}}

  {{#if counterOutOfRange}}
    <div class="clash-result-card__regen-summary">
      <div class="clash-damage-line">
        <i class="fa-solid fa-ban"></i>
        {{i18n.counterOutOfRange}}
      </div>
    </div>
  {{/if}}

  {{!-- Block win: ST damage to attacker summary --}}
  {{#if blockWinSt}}
    <div class="clash-result-card__regen-summary">
      <div class="clash-damage-line clash-damage-line--st-regen">
        <i class="fa-solid fa-shield"></i>
        {{state.margin}}
        {{i18n.stDamageToAttacker}}
      </div>
    </div>
  {{/if}}

  {{#if blockWinExempt}}
    <div class="clash-result-card__regen-summary">
      <div class="clash-damage-line">
        <i class="fa-solid fa-ban"></i>
        {{i18n.blockWinRangedExempt}}
      </div>
    </div>
  {{/if}}

  {{!-- Evade win: ST regen summary --}}
  {{#if evadeWin}}
    <div class="clash-result-card__regen-summary">
      <div class="clash-damage-line clash-damage-line--st-regen">
        <i class="fa-solid fa-shield-plus"></i>
        {{state.defenseRollTotal}}
        {{i18n.stRegen}}
      </div>
    </div>
  {{/if}}

  <div class="chat-damage-buttons" data-pool="{{poolSelect.pool}}" data-pools="{{poolSelect.pools}}" data-damage-type="{{#if state.damageType}}{{state.damageType}}{{else}}none{{/if}}">
    <div class="chat-damage-types" role="group" aria-label="{{localize "PMTTRPG.DamageTaken.TypeSelect"}}">
      <button type="button" class="button dtype{{#if (or (eq state.damageType "none") (not state.damageType))}} active{{/if}}" data-action="set-damage-type" data-damage-type="none" title="{{localize "PMTTRPG.DamageTypeNone"}}">{{localize "PMTTRPG.DamageTypeNone"}}</button>
      <button type="button" class="button dtype{{#ifEquals state.damageType "slash"}} active{{/ifEquals}}" data-action="set-damage-type" data-damage-type="slash" title="{{localize "PMTTRPG.DamageTypeSlash"}}">{{localize "PMTTRPG.DamageTypeSlash"}}</button>
      <button type="button" class="button dtype{{#ifEquals state.damageType "pierce"}} active{{/ifEquals}}" data-action="set-damage-type" data-damage-type="pierce" title="{{localize "PMTTRPG.DamageTypePierce"}}">{{localize "PMTTRPG.DamageTypePierce"}}</button>
      <button type="button" class="button dtype{{#ifEquals state.damageType "blunt"}} active{{/ifEquals}}" data-action="set-damage-type" data-damage-type="blunt" title="{{localize "PMTTRPG.DamageTypeBlunt"}}">{{localize "PMTTRPG.DamageTypeBlunt"}}</button>
    </div>
    <div class="chat-damage-pools" role="group" aria-label="{{localize "PMTTRPG.DamageTaken.PoolSelect"}}" title="{{localize "PMTTRPG.DamageTaken.PoolHint"}}">
      <button type="button" class="button pool{{#if poolSelect.hp}} active{{/if}}" data-action="set-pool" data-pool="hp">{{localize "PMTTRPG.TrackerHP"}}</button>
      <button type="button" class="button pool{{#if poolSelect.st}} active{{/if}}" data-action="set-pool" data-pool="st">{{localize "PMTTRPG.TrackerST"}}</button>
      <button type="button" class="button pool{{#if poolSelect.sp}} active{{/if}}" data-action="set-pool" data-pool="sp">{{localize "PMTTRPG.TrackerSP"}}</button>
    </div>
    {{#if applyTarget}}
    <button type="button" class="clash-apply-target{{#if (eq applyTarget.kind "heal")}} clash-apply-target--heal{{/if}}" data-action="{{#if (eq applyTarget.kind "heal")}}clash-heal{{else}}clash-damage{{/if}}" title="{{i18n.applyTargetTitle}}">
      <img class="clash-apply-target__avatar" src="{{applyTarget.img}}" alt="">
      <span class="clash-apply-target__label">{{i18n.applyTargetLabel}}</span>
      <i class="fa-solid {{#if (eq applyTarget.kind "heal")}}fa-user-plus{{else}}fa-user-minus{{/if}}"></i>
    </button>
    {{/if}}
    <div class="chat-damage-apply">
      <button type="button" class="button damage full-damage" data-action="clash-damage" title="{{i18n.applyFullTitle}}"><i class="fas fa-user-minus"></i></button>
      <button type="button" class="button damage half-damage" data-action="clash-half-damage" title="{{i18n.applyHalfTitle}}"><i class="fas fa-user-minus"></i> 1/2</button>
      <button type="button" class="button damage double-damage" data-action="clash-double-damage" title="{{i18n.applyDoubleTitle}}"><i class="fas fa-user-minus"></i> 2X</button>
      <button type="button" class="button heal heal-damage" data-action="clash-heal" title="{{i18n.applyHealTitle}}"><i class="fas fa-user-plus"></i></button>
    </div>
  </div>
</div>
