<div class="main-stat-display-card">
    <div class="stat-image" style="--percent: {{stat.percent}};">
        <img src="{{stat.icon}}" alt="{{stat.name}}">
        <img src="{{stat.icon}}" class="grayscale" alt="{{stat.name}}">
    </div>

    <span class="stat-amount">{{stat.amount}}</span>
</div>