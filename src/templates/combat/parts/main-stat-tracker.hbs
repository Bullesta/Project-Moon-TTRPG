<div class="main-stat-card" data-tracker-context data-reveal-key="{{stat.key}}">
    <div class="stat-icon-wrap" style="--percent: {{stat.percent}};">
        <img src="{{stat.icon}}" class="stat-icon stat-icon--grey"   alt="">
        <img src="{{stat.icon}}" class="stat-icon stat-icon--colour" alt="{{stat.name}}">
    </div>
    <input
        class="stat-amount {{#if stat.editable}}editable{{/if}} {{inputFontSize stat.amount}} num cur"
        type="text"
        value="{{stat.amount}}"
        {{#if stat.editable}}
            data-stat-path="{{stat.path}}"
            data-actor-id="{{actorData._id}}"
            data-dtype="Number"
        {{else}}
            readonly
            tabindex="-1"
        {{/if}}
    ></input>
    {{#if stat.showRevealEye}}
        <i class="fas fa-eye char-revealed" title="{{localize "PMTTRPG.Combat.TrackerRevealed"}}" aria-hidden="true"></i>
    {{else if stat.showHiddenEye}}
        <i class="fas fa-eye-slash char-hidden" title="{{localize "PMTTRPG.Combat.TrackerHidden"}}" aria-hidden="true"></i>
    {{/if}}
</div>
