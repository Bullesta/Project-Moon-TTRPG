<div 
    class="character {{#if isExpanded}}is-expanded{{/if}} {{#if isCurrentTurn}}current-turn{{/if}}" 
    {{#if actorData.system.details.color}}style="background: color-mix(var(--ct-bg), {{actorData.system.details.color}} 30%)"{{/if}}
    data-combatant-id="{{combatantData._id}}"
>
    <div class="main-part">
        <div class="avatar-side">
            <div class="avatar" data-action="openSheet" title="{{actorData.name}}">
                <img src="{{actorData.img}}" alt="{{actorData.name}}">
            </div>

            {{#if showFull}}
            <button
                type="button"
                class="char-toggle-details"
                data-action="toggleDetails"
                aria-expanded="{{isExpanded}}"
                title="{{localize "PMTTRPG.Common.Details"}}"
                aria-label="{{localize "PMTTRPG.Common.Details"}}"
            >
                <i class="fas {{#if isExpanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>
            {{/if}}
        </div>

        <div class="right-side">
            <div class="name-container">
                {{#if actorData.system.details.badge}}
                    <img class="faction-badge" src="{{actorData.system.details.badge}}">
                {{/if}}
                <span class="char-name">{{actorData.name}}</span>
                {{#ifEquals actorData.type 'npc'}}
                    <span class="npc-badge">NPC</span>
                {{/ifEquals}}
            </div>

            <div class="main-stats">
                {{#if showFull}}
                {{> "systems/projectmoonttrpg/templates/combat/parts/initiative-tracker.hbs"
                    initiative=combatantData.initiative }}
                {{else}}
                {{> "systems/projectmoonttrpg/templates/combat/parts/initiative-tracker.hbs"
                    initiative="?" }}
                {{/if}}

                {{#if showFull}}
                {{#each mainStats}}
                    {{> "systems/projectmoonttrpg/templates/combat/parts/main-stat-tracker.hbs" stat=this actorData=../actorData}}
                {{/each}}
                {{/if}}
            </div>
        </div>
    </div>

    {{#if showFull}}
    <div class="details" aria-hidden="{{#unless isExpanded}}true{{/unless}}">
        {{#each detailedStats}}
            {{> "systems/projectmoonttrpg/templates/combat/parts/detail-stat-tracker.hbs" stat=this actorData=../actorData}}
        {{/each}}
    </div>
    {{/if}}
</div>
