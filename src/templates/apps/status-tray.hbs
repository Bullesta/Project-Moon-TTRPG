<ul class="pmttrpg-status-tray__list" aria-label="{{localize 'PMTTRPG.ActiveStatuses'}}">
  {{#each statuses as |status|}}
    <li
      class="pmttrpg-status-tray__item{{#if status.pending}} pmttrpg-status-tray__item--pending{{else}}{{#unless status.showCount}} unstackable{{/unless}}{{/if}}"
      data-action="adjustStatus"
      data-status-name="{{status.name}}"
      data-item-id="{{status.itemId}}"
      data-pending="{{#if status.pending}}true{{else}}false{{/if}}"
      data-arrival="{{status.arrival}}"
      data-tooltip-direction="LEFT"
      data-tooltip-class="pmttrpg-status-tip"
    >
      <img class="pmttrpg-status-tray__icon" src="{{status.img}}" alt="" draggable="false" />
      {{#if status.showCount}}
      <span class="pmttrpg-status-tray__stack">{{status.count}}</span>
      {{/if}}
    </li>
  {{/each}}
</ul>
